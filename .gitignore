# Xcode build output
build/
DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Agent local state — never published
.claude/
.codex/
.commandcode/

# Internal working docs — kept local only, never published
AGENTS.md
CLAUDE.md

# Local hosted-model gateway — contains nono's private upstream routing.
backend/
# Wrangler's local secrets, at any depth. Today backend/.dev.vars is covered
# by the line above, but only for as long as the whole directory stays out of
# the repo. The moment one file in it is committed, that cover is gone and the
# secrets are not. This line is what holds then.
.dev.vars
.dev.vars.*
!.dev.vars.example
# A stray `npm` run at the repo root leaves one here — the vitest cache turned
# up staged on the 0.8.2 release commit. The backend keeps its own.
node_modules/

# Landing page / front-end — kept local only, deployed via Vercel, never
# published to this repo. Includes ROADMAP/reviews docs that lived here too.
docs/
# Guard for the local-only roadmap docs above — useless to anyone cloning the
# repo (they have no roadmap files), and its text describes the internal flow.
scripts/check-roadmap.sh

# Marketing video projects — local-only HyperFrames source + heavy binary
# artifacts (PNG snapshots, mp3 SFX). Like docs/, these are promo assets that
# don't belong in the app repo.
videos/

# Generated / scratch output — promo renders, exported docs, PDF page dumps,
# preview HTML. All regenerable, none of it belongs in the app repo.
output/
tmp/
.readme-preview.html

# Local dev seeding tool — writes fake history into Application Support.
scripts/seed-history.py

# Misc
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
